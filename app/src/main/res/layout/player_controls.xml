<?xml version="1.0" encoding="utf-8"?>
<!-- The player's controls, replacing media3's default layout via app:controller_layout_id.

     This is media3's own stock layout with things removed, not a restyling: the time bar, the
     position/duration labels and the settings gear keep media3's styles, sizes and colours.

     Gone: exo_controls_background (the scrim), the whole exo_center_controls row (the arrow keys
     seek directly now, and with one media item ⏭ is always disabled while ⏮ only jumps to
     0:00), exo_fullscreen (a TV is always fullscreen), and exo_vr / exo_shuffle /
     exo_repeat_toggle / exo_overflow_*. exo_subtitle stays out too: the project renders
     subtitles itself, so its CC button lives in the sub-sync capsule (see PlayerActivity).

     PlayerControlView resolves every button with findViewById and null-checks it, so leaving one
     out is supported, not a hack. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/exo_styled_bottom_bar_time_padding"
        android:paddingEnd="@dimen/exo_styled_bottom_bar_time_padding"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- @id, not @+id: PlayerControlView finds the bar with findViewById(R.id.exo_progress)
             against media3's own id, so this must reference that declared id rather than mint a
             new one — a fresh id would leave it with no time bar at all.

             The bar is focusable so left/right on it can be intercepted and seek; the sizes are
             media3's ExoStyledControls.TimeBar values, restated because a DefaultTimeBar
             declared in XML does not inherit that style (it is applied only to the bar media3
             builds itself from a placeholder) and the class defaults differ. Colours are left
             entirely to media3. -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/exo_styled_progress_layout_height"
            android:focusable="true"
            android:nextFocusDown="@id/exo_settings"
            app:bar_height="@dimen/exo_styled_progress_bar_height"
            app:bar_gravity="bottom"
            app:touch_target_height="@dimen/exo_styled_progress_touch_target_height"
            app:scrubber_enabled_size="@dimen/exo_styled_progress_enabled_thumb_size"
            app:scrubber_dragged_size="@dimen/exo_styled_progress_dragged_thumb_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- media3's own exo_time group, verbatim: the separator carries no id there
                 either, and importantForAccessibility keeps a running clock from being read
                 out on every tick. -->
            <LinearLayout
                android:id="@id/exo_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layoutDirection="ltr"
                android:importantForAccessibility="noHideDescendants">

                <TextView
                    android:id="@id/exo_position"
                    style="@style/ExoStyledControls.TimeText.Position" />

                <TextView
                    style="@style/ExoStyledControls.TimeText.Separator" />

                <TextView
                    android:id="@id/exo_duration"
                    style="@style/ExoStyledControls.TimeText.Duration" />
            </LinearLayout>

            <!-- Pushes the gear to the far end. -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- media3's own settings button, styled by media3. Focus is pinned the way the
                 chrome bar pins its own: up returns to the time bar, and left/right stay put
                 rather than searching off to the sub-sync capsule across the screen. It is the
                 only focusable control in this row. -->
            <ImageButton
                android:id="@id/exo_settings"
                style="@style/ExoStyledControls.Button.Bottom.Settings"
                android:nextFocusUp="@id/exo_progress"
                android:nextFocusLeft="@id/exo_settings"
                android:nextFocusRight="@id/exo_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
